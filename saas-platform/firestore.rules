rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Custom claims (set server-side only, for staff/manager roles)
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function hasRestaurantAccess(restaurantId) {
      return isAuthenticated() && request.auth.token.restaurantId == restaurantId;
    }

    function isStaff(restaurantId) {
      return hasRestaurantAccess(restaurantId) && (hasRole('cook') || hasRole('waiter') || hasRole('staff'));
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // Primary: fast check using ownerId field on the document itself.
    // Fallback: restaurant lookup for legacy docs that predate the ownerId field.
    function isDocOwner() {
      return isAuthenticated() && (
        // Fast path — ownerId is on the doc (new documents)
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid)
        // Fallback path — look up restaurant for legacy docs without ownerId
        || (!('ownerId' in resource.data) && 'restaurantId' in resource.data &&
            get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerId == request.auth.uid)
      );
    }

    // For create: check ownerId on incoming data
    function isNewDocOwner() {
      return isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // ─── Restaurants ─────────────────────────────────────────────────────────
    // Public read so customer menu pages work without auth.
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Categories ──────────────────────────────────────────────────────────
    // Public read so customers can see the menu.
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isNewDocOwner() || isAdmin();
      allow update: if isDocOwner()
                    && request.resource.data.restaurantId == resource.data.restaurantId
                    || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // ─── Menu Items ───────────────────────────────────────────────────────────
    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if isNewDocOwner() || isAdmin();
      allow update: if isDocOwner()
                    && request.resource.data.restaurantId == resource.data.restaurantId
                    || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // ─── Tables ───────────────────────────────────────────────────────────────
    match /tables/{tableId} {
      allow read: if isDocOwner()
                  || isStaff(resource.data.restaurantId)
                  || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
      allow update: if isDocOwner()
                    && request.resource.data.restaurantId == resource.data.restaurantId
                    || isAdmin();
      allow delete: if isDocOwner() || isAdmin();
    }

    // ─── Orders ───────────────────────────────────────────────────────────────
    // Created exclusively via Admin SDK server route — client create is blocked.
    match /orders/{orderId} {
      allow read: if isDocOwner()
                  || isStaff(resource.data.restaurantId)
                  || isAdmin();

      allow create: if false; // Server-side only (Admin SDK bypasses rules)

      // Owner/staff can update only the status & updatedAt fields.
      // Protect restaurantId from being changed (compare via existing doc).
      allow update: if (isDocOwner() || isStaff(resource.data.restaurantId))
                    && request.resource.data.restaurantId == resource.data.restaurantId
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Razorpay Keys ────────────────────────────────────────────────────────
    match /razorpayKeys/{docId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // ─── Audit Logs ───────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── Staff ────────────────────────────────────────────────────────────────
    match /staff/{staffId} {
      allow read: if isDocOwner() || isStaff(resource.data.restaurantId) || isAdmin();
      allow create, update, delete: if false; // Only server handles this
    }

    // ─── Waiter Calls ─────────────────────────────────────────────────────────
    match /waiterCalls/{callId} {
      allow read: if isDocOwner()
                  || isStaff(resource.data.restaurantId);

      // Customers (unauthenticated) can create waiter calls
      allow create: if request.resource.data.keys().hasAll(['restaurantId', 'tableId', 'createdAt'])
                    && request.resource.data.restaurantId is string
                    && request.resource.data.tableId is string;

      allow update, delete: if isDocOwner()
                            || isStaff(resource.data.restaurantId);
    }
  }
}
